#!/bin/sh

DAEMON="tailscaled"
DAEMON_PATH="/usr/sbin/$DAEMON"
CLIENT_PATH="/usr/bin/tailscale"
PIDFILE="/var/run/$DAEMON.pid"
PORT="41641"
FLAGS=""
PKG_URL_LATEST="https://pkgs.tailscale.com/stable/tailscale_latest_riscv64.tgz"

# A pid file is advisory only: it can survive a crash and its PID can later be
# reused. Verify /proc/<pid>/exe before signalling anything. The "(deleted)"
# form is still a live daemon and must be stopped before an uninstall/switch.
is_daemon_pid() {
    pid="$1"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    target=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [ "$target" = "$DAEMON_PATH" ] || [ "$target" = "$DAEMON_PATH (deleted)" ]
}

daemon_pids() {
    for pid in $(pidof "$DAEMON" 2>/dev/null); do
        is_daemon_pid "$pid" && printf '%s\n' "$pid"
    done
}

daemon_running() {
    [ -n "$(daemon_pids)" ]
}

wait_for_start() {
    timeout="$1"
    elapsed=0
    while ! daemon_running; do
        [ "$elapsed" -ge "$timeout" ] && return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

wait_for_exit() {
    timeout="$1"
    elapsed=0
    while daemon_running; do
        [ "$elapsed" -ge "$timeout" ] && return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

signal_daemons() {
    signal="$1"
    pids=$(daemon_pids)
    [ -n "$pids" ] || return 0

    for pid in $pids; do
        # Re-check immediately before kill to avoid acting on a recycled PID.
        is_daemon_pid "$pid" || continue
        kill -"$signal" "$pid" 2>/dev/null || {
            is_daemon_pid "$pid" && return 1
        }
    done
    return 0
}

stop_daemon() {
    printf "Stopping %s: " "$DAEMON"
    if ! daemon_running; then
        rm -f "$PIDFILE"
        echo "not running"
        return 0
    fi

    if ! signal_daemons TERM || ! wait_for_exit 10; then
        signal_daemons KILL || true
        if ! wait_for_exit 5; then
            echo "FAIL"
            return 1
        fi
    fi

    rm -f "$PIDFILE"
    echo "OK"

    # Cleanup is useful but a failure after confirmed process termination must
    # not lie that Stop failed (and make callers retry an already safe stop).
    if [ -x "$DAEMON_PATH" ]; then
        "$DAEMON_PATH" --cleanup >/dev/null 2>&1 || true
    fi
    return 0
}

case "$1" in
    start)
        [ -x "$DAEMON_PATH" ] || {
            echo "$DAEMON_PATH not found, please download it from $PKG_URL_LATEST"
            echo "Then unpack it, copy $DAEMON to /usr/sbin and copy tailscale to /usr/bin"
            exit 1
        }
        [ -x "$CLIENT_PATH" ] || {
            echo "$CLIENT_PATH not found, your installation of tailscale may be broken"
            exit 1
        }

        if daemon_running; then
            echo "$DAEMON already running"
            exit 0
        fi
        rm -f "$PIDFILE"

        # Clean up old forwarding configuration if it exists.
        if [ -f /etc/sysctl.d/99-tailscale.conf ]; then
            echo "Found old forwarding configuration, cleaning up..."
            rm -f /etc/sysctl.d/99-tailscale.conf
            sysctl -w net.ipv4.ip_forward=0 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.all.forwarding=0 >/dev/null 2>&1
            for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
                echo 0 > "/proc/sys/net/ipv6/conf/$iface/forwarding" 2>/dev/null
                sysctl -w "net.ipv6.conf.$iface.accept_ra=2" >/dev/null 2>&1
            done
        fi

        if [ -f /etc/kvm/GOMEMLIMIT ]; then
            value=$(cat /etc/kvm/GOMEMLIMIT)
            export GOMEMLIMIT="${value}MiB"
        else
            export GOMEMLIMIT=512MiB
        fi

        mkdir -p /var/lib/tailscale /var/run/tailscale
        version=$($DAEMON_PATH --version 2>/dev/null | sed -n '1p' | xargs echo -n)
        printf "Starting %s[%s]: " "$DAEMON" "$version"
        if start-stop-daemon -S -bmq -p "$PIDFILE" -x "$DAEMON_PATH" -- \
            --state=/var/lib/tailscale/tailscaled.state \
            --socket=/var/run/tailscale/tailscaled.sock \
            --port="$PORT" $FLAGS && wait_for_start 5; then
            echo "OK"
            "$CLIENT_PATH" set --accept-dns=false >/dev/null 2>&1 || true
            exit 0
        fi
        echo "FAIL"
        exit 1
        ;;
    stop)
        stop_daemon
        exit $?
        ;;
    restart|reload)
        "$0" stop || exit $?
        "$0" start
        exit $?
        ;;
    status)
        if daemon_running; then
            echo "$DAEMON is running"
            exit 0
        fi
        echo "$DAEMON is not running"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
