#!/bin/sh

DAEMON="netbird"
DAEMON_PATH="/usr/bin/netbird"
PIDFILE="/var/run/$DAEMON.pid"
LOGDIR="/var/log/netbird"
LOGFILE="$LOGDIR/netbird.log"

ensure_tun() {
  [ -d /dev/net ] || mkdir -p /dev/net
  if [ ! -c /dev/net/tun ]; then
    [ -x /sbin/modprobe ] && modprobe tun 2>/dev/null || true
    [ -f /lib/modules/tun.ko ] && insmod /lib/modules/tun.ko 2>/dev/null || true
    mknod /dev/net/tun c 10 200 2>/dev/null || true
    chmod 0755 /dev/net/tun 2>/dev/null || true
  fi
}

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "$1" in
  start)
    [ -x "$DAEMON_PATH" ] || {
      echo "$DAEMON_PATH not found"
      exit 1
    }

    if is_running; then
      echo "$DAEMON already running"
      exit 0
    fi

    mkdir -p /var/run "$LOGDIR"
    ensure_tun

    export GOMEMLIMIT=20MiB

    # ── NetBird config patches (applied before daemon start) ─────
    NB_CONFIG="/var/lib/netbird/default.json"
    if [ -f "$NB_CONFIG" ]; then
      # Firewall manager on RISC-V creates iptables chains
      # (NETBIRD-ACL-INPUT) but does not populate them — all wt0
      # traffic gets DROPped. Disable the broken manager entirely.
      sed -i 's/"DisableFirewall": false/"DisableFirewall": true/' "$NB_CONFIG"

      # No IPv6 on wt0 — skip IPv6 ICE candidates to save CPU.
      sed -i 's/"DisableIPv6Discovery": false/"DisableIPv6Discovery": true/' "$NB_CONFIG"

      # Connect to peers only on actual traffic — saves memory
      # and CPU for offline peers on this resource-constrained device.
      sed -i 's/"LazyConnectionEnabled": false/"LazyConnectionEnabled": true/' "$NB_CONFIG"

      # NetBird DNS routing is not used — disable to save memory.
      sed -i 's/"DisableDNS": false/"DisableDNS": true/' "$NB_CONFIG"
    fi

    # ── Log rotation (no logrotate on Buildroot) ─────────────────
    LOG_MAX_KB=1024
    for f in "$LOGDIR"/client.log "$LOGFILE"; do
      if [ -f "$f" ]; then
        sz=$(du -k "$f" 2>/dev/null | cut -f1)
        if [ "${sz:-0}" -gt "$LOG_MAX_KB" ]; then
          tail -n 200 "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
        fi
      fi
    done

    printf "Starting %s (GOMEMLIMIT=%s): " "$DAEMON" "$GOMEMLIMIT"
    start-stop-daemon -S -bmq -p "$PIDFILE" -x "$DAEMON_PATH" -- service run >>"$LOGFILE" 2>&1
    if [ $? = 0 ]; then
      echo "OK"
    else
      echo "FAIL"
      exit 1
    fi
    ;;

  stop)
    printf "Stopping %s: " "$DAEMON"
    if [ -f "$PIDFILE" ]; then
      start-stop-daemon -K -p "$PIDFILE" >/dev/null 2>&1
      [ $? = 0 ] && (echo "OK"; rm -f "$PIDFILE") || (echo "FAIL"; exit 1)
    else
      echo "not running"
    fi
    ;;

  restart)
    "$0" stop
    "$0" start
    ;;

  status)
    if is_running; then
      echo "$DAEMON is running"
      exit 0
    fi
    echo "$DAEMON is not running"
    exit 1
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
