#!/bin/sh

DAEMON="netbird"
DAEMON_PATH="/usr/bin/netbird"
PIDFILE="/var/run/$DAEMON.pid"
LOGDIR="/var/log/netbird"
LOGFILE="$LOGDIR/netbird.log"

ensure_tun() {
    [ -d /dev/net ] || mkdir -p /dev/net
    if [ ! -c /dev/net/tun ]; then
        [ -x /sbin/modprobe ] && modprobe tun 2>/dev/null || true
        [ -f /lib/modules/tun.ko ] && insmod /lib/modules/tun.ko 2>/dev/null || true
        mknod /dev/net/tun c 10 200 2>/dev/null || true
        chmod 0755 /dev/net/tun 2>/dev/null || true
    fi
}

# Do not trust PIDFILE or process name alone. A stale PID can point at an
# unrelated process, while a deleted executable can still be a live NetBird
# daemon. /proc/exe gives both identity and the latter case.
is_daemon_pid() {
    pid="$1"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    target=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [ "$target" = "$DAEMON_PATH" ] || [ "$target" = "$DAEMON_PATH (deleted)" ] || return 1
    cmdline=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    case " $cmdline " in
        *" service run "*) return 0 ;;
        *) return 1 ;;
    esac
}

daemon_pids() {
    for pid in $(pidof "$DAEMON" 2>/dev/null); do
        is_daemon_pid "$pid" && printf '%s\n' "$pid"
    done
}

daemon_running() {
    [ -n "$(daemon_pids)" ]
}

wait_for_start() {
    timeout="$1"
    elapsed=0
    while ! daemon_running; do
        [ "$elapsed" -ge "$timeout" ] && return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

wait_for_exit() {
    timeout="$1"
    elapsed=0
    while daemon_running; do
        [ "$elapsed" -ge "$timeout" ] && return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

signal_daemons() {
    signal="$1"
    pids=$(daemon_pids)
    [ -n "$pids" ] || return 0

    for pid in $pids; do
        # Re-check immediately before kill to reduce the PID-reuse race.
        is_daemon_pid "$pid" || continue
        kill -"$signal" "$pid" 2>/dev/null || {
            is_daemon_pid "$pid" && return 1
        }
    done
    return 0
}

stop_daemon() {
    printf "Stopping %s: " "$DAEMON"
    if ! daemon_running; then
        rm -f "$PIDFILE"
        echo "not running"
        return 0
    fi

    if ! signal_daemons TERM || ! wait_for_exit 10; then
        signal_daemons KILL || true
        if ! wait_for_exit 5; then
            echo "FAIL"
            return 1
        fi
    fi

    rm -f "$PIDFILE"
    echo "OK"
    return 0
}

case "$1" in
    start)
        [ -x "$DAEMON_PATH" ] || {
            echo "$DAEMON_PATH not found"
            exit 1
        }
        if daemon_running; then
            echo "$DAEMON already running"
            exit 0
        fi
        rm -f "$PIDFILE"

        mkdir -p /var/run "$LOGDIR"
        ensure_tun
        export GOMEMLIMIT=30MiB

        printf "Starting %s (GOMEMLIMIT=%s): " "$DAEMON" "$GOMEMLIMIT"
        if start-stop-daemon -S -bmq -p "$PIDFILE" -x "$DAEMON_PATH" -- service run >>"$LOGFILE" 2>&1 && wait_for_start 5; then
            echo "OK"
            exit 0
        fi
        echo "FAIL"
        exit 1
        ;;
    stop)
        stop_daemon
        exit $?
        ;;
    restart)
        "$0" stop || exit $?
        "$0" start
        exit $?
        ;;
    status)
        if daemon_running; then
            echo "$DAEMON is running"
            exit 0
        fi
        echo "$DAEMON is not running"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
