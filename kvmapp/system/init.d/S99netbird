#!/bin/sh

DAEMON="netbird"
DAEMON_PATH="/usr/bin/netbird"
PIDFILE="/var/run/$DAEMON.pid"
LOGDIR="/var/log/netbird"
LOGFILE="$LOGDIR/netbird.log"

ensure_tun() {
  [ -d /dev/net ] || mkdir -p /dev/net
  if [ ! -c /dev/net/tun ]; then
    [ -x /sbin/modprobe ] && modprobe tun 2>/dev/null || true
    [ -f /lib/modules/tun.ko ] && insmod /lib/modules/tun.ko 2>/dev/null || true
    mknod /dev/net/tun c 10 200 2>/dev/null || true
    chmod 0755 /dev/net/tun 2>/dev/null || true
  fi
}

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

is_running_without_pidfile() {
  pidof "$DAEMON" >/dev/null 2>&1
}

# start-stop-daemon -K and killall both return as soon as the signal is SENT.
# A zero exit status says nothing about whether the process is gone, so every
# stop has to confirm by polling. Callers use this answer to decide whether it
# is safe to start the other VPN client.
wait_for_exit() {
  timeout="$1"
  elapsed=0

  while pidof "$DAEMON" >/dev/null 2>&1; do
    if [ "$elapsed" -ge "$timeout" ]; then
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  return 0
}

case "$1" in
  start)
    [ -x "$DAEMON_PATH" ] || {
      echo "$DAEMON_PATH not found"
      exit 1
    }

    if is_running; then
      echo "$DAEMON already running"
      exit 0
    fi

    mkdir -p /var/run "$LOGDIR"
    ensure_tun

    export GOMEMLIMIT=30MiB

    printf "Starting %s (GOMEMLIMIT=%s): " "$DAEMON" "$GOMEMLIMIT"
    start-stop-daemon -S -bmq -p "$PIDFILE" -x "$DAEMON_PATH" -- service run >>"$LOGFILE" 2>&1
    if [ $? = 0 ]; then
      echo "OK"
    else
      echo "FAIL"
      exit 1
    fi
    ;;

  stop)
    printf "Stopping %s: " "$DAEMON"
    if [ -f "$PIDFILE" ]; then
      # A pidfile holding a stale, recycled pid signals a stranger here. Adding
      # -x "$DAEMON_PATH" would pin the signal to a process running this binary,
      # but that has not been confirmed against the busybox build on the device;
      # if it failed to match, the stop would fall through to the SIGKILL below
      # after a ten-second wait instead of terminating gracefully. Both outcomes
      # are rare, and the wait below bounds either of them.
      start-stop-daemon -K -p "$PIDFILE" >/dev/null 2>&1
    elif is_running_without_pidfile; then
      # A missing pidfile is not proof the daemon is gone.
      killall "$DAEMON" 2>/dev/null
    else
      echo "not running"
      rm -f "$PIDFILE"
      exit 0
    fi

    # Whatever the signal senders reported, only the process table decides.
    if wait_for_exit 10; then
      echo "OK"
      rm -f "$PIDFILE"
    else
      killall -9 "$DAEMON" 2>/dev/null
      if wait_for_exit 5; then
        echo "OK"
        rm -f "$PIDFILE"
      else
        echo "FAIL"
        exit 1
      fi
    fi
    ;;

  restart)
    "$0" stop
    "$0" start
    ;;

  status)
    if is_running; then
      echo "$DAEMON is running"
      exit 0
    fi
    echo "$DAEMON is not running"
    exit 1
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
